{
  "manifest_version": 3,
  "name": "轻狐AI 发布助手",
  "version": "1.0.0",
  "description": "从轻狐AI文章列表一键发布到微信公众号、小红书、抖音、B站专栏、今日头条、知乎、阿里云社区、CSDN、百家号",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "scripting",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://mp.weixin.qq.com/*",
    "https://creator.xiaohongshu.com/*",
    "https://creator.douyin.com/*",
    "https://member.bilibili.com/*",
    "https://mp.toutiao.com/*",
    "https://zhuanlan.zhihu.com/*",
    "https://developer.aliyun.com/*",
    "https://editor.csdn.net/*",
    "https://baijiahao.baidu.com/*",
    "https://contentai.hnzant.com/*",
    "http://localhost/*",
    "http://localhost:8000/*",
    "http://localhost:8765/*",
    "http://localhost:5500/*",
    "http://localhost:3000/*",
    "http://wwork.hnzant.com/*",
    "https://wwork.hnzant.com/*",
    "https://shengmingzhishu.github.io/*",
    "https://*.myqcloud.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "update_url": "https://contentai.hnzant.com/api/extension/update.xml",
  "content_scripts": [
    {
      "matches": [
        "https://contentai.hnzant.com/*",
        "http://localhost:8000/*",
        "http://localhost:8765/*",
        "http://localhost:5500/*",
        "http://localhost:3000/*",
        "http://wwork.hnzant.com/*",
        "https://shengmingzhishu.github.io/*",
        "file:///*"
      ],
      "js": [
        "config.js",
        "lib/url-utils.js",
        "lib/content-utils.js",
        "content-scripts/contentai-injector.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://mp.weixin.qq.com/*"],
      "js": [
        "config.js",
        "lib/content-utils.js",
        "content-scripts/wechat.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://creator.xiaohongshu.com/*"],
      "js": [
        "config.js",
        "lib/content-utils.js",
        "content-scripts/xiaohongshu.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://creator.douyin.com/*"],
      "js": [
        "config.js",
        "lib/content-utils.js",
        "content-scripts/douyin.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://member.bilibili.com/*"],
      "js": [
        "config.js",
        "lib/content-utils.js",
        "content-scripts/bilibili.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://mp.toutiao.com/*"],
      "js": [
        "config.js",
        "lib/content-utils.js",
        "content-scripts/toutiao.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://zhuanlan.zhihu.com/*"],
      "js": [
        "config.js",
        "lib/content-utils.js",
        "content-scripts/zhihu.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://developer.aliyun.com/*"],
      "js": [
        "config.js",
        "lib/content-utils.js",
        "content-scripts/aliyun.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://editor.csdn.net/*"],
      "js": [
        "config.js",
        "lib/content-utils.js",
        "content-scripts/csdn.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://baijiahao.baidu.com/*"],
      "js": [
        "config.js",
        "lib/content-utils.js",
        "content-scripts/baijiahao.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "轻狐AI 发布助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [{
    "resources": ["content-scripts/inject-aliyun.js"],
    "matches": ["https://developer.aliyun.com/*"]
  }, {
    "resources": ["content-scripts/douyin-react-setcover.js", "content-scripts/douyin-react-executor.js"],
    "matches": ["https://creator.douyin.com/*"]
  }],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
